# API Configuration
REACT_APP_API_URL=http://localhost:8001

# Public browser keys only. Restrict these in Google Cloud by HTTP referrer and API.
REACT_APP_YOUTUBE_API_KEY=your_restricted_youtube_browser_key_here
REACT_APP_GOOGLE_BOOKS_API_KEY=your_restricted_google_books_browser_key_here

# Development Configuration
REACT_APP_DEBUG=true
